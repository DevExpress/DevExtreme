//# ─────────────────────────────────────────────────────────────────────────────
//# DevExtreme Angular wrapper — component file template
//# Output: packages/devextreme-angular/src/ui/<path>/index.ts
//# How to fill it: see README.md next to this file.
//#
//# Every line starting with "//#" is a template directive or note — delete ALL
//# of them in the output. Keep every other line byte-for-byte, only replacing
//# __PLACEHOLDERS__. WHITESPACE MATTERS: several lines below consist of exactly
//# four spaces ("    ") — keep them; do not let an editor strip them.
//#
//#   //#if FLAG … //#else … //#endif   keep the branch whose FLAG holds
//#   //#each ITEM … //#endeach         repeat the body once per ITEM (0..n times)
//#   //#each … //#sep … //#endeach     lines after //#sep are emitted only BETWEEN items
//#
//# Blank lines are content, exactly like code lines. Removing a skipped block
//# removes only the lines INSIDE it — never merge or collapse the blank lines
//# around it. Count the output's blank lines against the README §7 table.
//#
//# Lists have any length; a single line in an //#each is repeated per item.
//#
//# Flags:  GENERIC      Properties has type params
//#         EDITOR       the options include `onValueChanged` (README §1)
//#         COLL         ≥1 COLLECTION PROPERTY (README §3: array-typed or dataSource)
//#         CO           ≥1 nested COLLECTION ITEM component (README §5) — implies COLL
//#         NESTED       ≥1 nested component
//#         TRANSCLUDED  widget class JSDoc has `@hasTranscludedContent`
//#         VIZ          module path starts with viz/
//#         NO_DISABLED  only dxRangeSelector (no setDisabledState)
//#
//# Placeholders:
//#   __Name__   PascalCase name without "dx"   TabPanel    (class DxTabPanel)
//#   __path__   kebab-case folder name         tab-panel
//#   __module__ d.ts path under js/            ui/tab_panel
//#   __TP__ / __TPD__   <TItem, TKey> / <TItem = any, TKey = any>, or empty
//#
//# Not covered: EXTENSION components (only dxValidator) and the legacy shared
//# `ui/nested/**` modules (deprecated — a new component never imports them).
//# ─────────────────────────────────────────────────────────────────────────────
