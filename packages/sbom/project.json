{
  "name": "sbom",
  "projectType": "library",
  "targets": {
    "install-dependencies": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm install --frozen-lockfile"
      }
    },
    "make": {
      "executor": "nx:run-commands",
      "dependsOn": ["install-dependencies"],
      "options": {
        "cwd": "{projectRoot}",
        "forwardAllArgs": false,
        "packages": "devextreme,devextreme-react,devextreme-angular,devextreme-vue,devextreme-themebuilder",
        "command": "node scripts/make.ts \"{args.packages}\""
      }
    }
  }
}
