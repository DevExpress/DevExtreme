{
    "plugins": [
        "stylelint-scss",
        "@stylistic/stylelint-plugin",
        "./tools/stylelint/no-identical-branch-declarations.ts",
        "./tools/stylelint/module-variable-default.ts",
        "./tools/stylelint/no-unused-use.ts"
    ],
    "extends": "stylelint-config-standard-scss",
    "ignoreFiles": "!**/*.{css,scss}",
    "reportInvalidScopeDisables": true,
    "reportNeedlessDisables": true,
    "rules": {
        "alpha-value-notation": "number",
        "@stylistic/block-closing-brace-newline-before": "always-multi-line",
        "@stylistic/block-opening-brace-space-before": "always",
        "color-function-notation": ["legacy", { "ignore": ["with-var-inside"] }],
        "declaration-block-no-redundant-longhand-properties": null,
        "@stylistic/declaration-block-semicolon-newline-after": "always-multi-line",
        "@stylistic/declaration-block-trailing-semicolon": "always",
        "@stylistic/declaration-colon-space-after": "always-single-line",
        "@stylistic/declaration-colon-space-before": "never",
        "declaration-no-important": true,
        "declaration-property-value-disallowed-list": [
            { "/.*/": ["/var\\(\\s*--dxds-/"] },
            { "message": "Read a design token through the ds bridge (ds.$name), not var(--dxds-…): the bridge fails the build on an unknown name, a raw custom property compiles and degrades silently." }
        ],
        "dx/module-variable-default": true,
        "dx/no-unused-use": true,
        "dx/no-identical-branch-declarations": true,
        "font-family-name-quotes": "always-unless-keyword",
        "@stylistic/function-comma-space-after": "always-single-line",
        "@stylistic/indentation": [2, { "ignore": ["inside-parens"] }],
        "keyframe-selector-notation": null,
        "keyframes-name-pattern": "^dx-[a-z0-9-]+$",
        "@stylistic/max-empty-lines": 1,
        "@stylistic/media-feature-colon-space-after": "always",
        "media-feature-range-notation": null,
        "no-descending-specificity": null,
        "@stylistic/no-empty-first-line": true,
        "no-empty-source": null,
        "@stylistic/no-eol-whitespace": true,
        "@stylistic/no-extra-semicolons": true,
        "@stylistic/no-missing-end-of-source-newline": true,
        "@stylistic/number-leading-zero": "always",
        "number-max-precision": 6,
        "selector-class-pattern": "dx-[a-z0-9-]+",
        "@stylistic/selector-combinator-space-after": "always",
        "@stylistic/selector-combinator-space-before": "always",
        "selector-max-id": 0,
        "selector-not-notation": null,
        "shorthand-property-no-redundant-values": null,
        "@stylistic/string-quotes": "double",
        "@stylistic/unit-case": "lower",
        "value-keyword-case": null,
        "value-no-vendor-prefix": true,

        "scss/at-else-empty-line-before": null,
        "scss/at-if-closing-brace-newline-after": null,
        "scss/at-if-closing-brace-space-after": null,
        "scss/at-mixin-argumentless-call-parentheses": "always",
        "scss/at-mixin-pattern": "^[a-z][0-9a-z-]*$",
        "scss/dimension-no-non-numeric-values": true,
        "scss/dollar-variable-empty-line-before": null,
        "scss/dollar-variable-pattern": "^[a-z][0-9a-z_-]*$",
        "scss/double-slash-comment-empty-line-before": "always",
        "scss/map-keys-quotes": "always",
        "scss/no-duplicate-dollar-variables": [true, { "ignoreInsideAtRules": ["if", "else"] }],
        "scss/operator-no-newline-after": null
    },
    "overrides": [
        {
            "comment": "fluent-next variable names are strict kebab-case: each one maps onto a public --dx-* custom property.",
            "files": ["scss/widgets/fluent-next/**/*.scss"],
            "rules": {
                "scss/dollar-variable-pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
            }
        },
        {
            "comment": "Rule files read design tokens through the widget's own variables. At-rule parameters are invisible to stylelint; fluent-next-naming.test.ts covers them.",
            "files": ["scss/widgets/fluent-next/**/*.scss"],
            "rules": {
                "declaration-property-value-disallowed-list": [
                    { "/.*/": ["/var\\(\\s*--dxds-/", "/\\bds\\.\\$/"] },
                    { "message": "Use the widget's own variable here: resolve the design token in _colors.scss or _sizes.scss. A custom property compiles even when its name is wrong." }
                ]
            }
        },
        {
            "comment": "Declaration files read design tokens through the ds bridge, not as custom properties.",
            "files": [
                "scss/widgets/fluent-next/**/_colors.scss",
                "scss/widgets/fluent-next/**/_sizes.scss",
                "scss/widgets/fluent-next/**/_variables.scss"
            ],
            "rules": {
                "declaration-property-value-disallowed-list": [
                    { "/.*/": ["/var\\(\\s*--dxds-/", "/var\\(\\s*--dx-/"] },
                    { "message": "Read a design token through the ds bridge (ds.$name), not as a custom property: the bridge fails the build on an unknown name, a custom property compiles and degrades silently." }
                ]
            }
        },
        {
            "comment": "cardView keeps its cross-theme BEM variable names.",
            "files": ["scss/widgets/fluent-next/cardView/**/*.scss"],
            "rules": {
                "scss/dollar-variable-pattern": "^[a-z][0-9a-z_-]*$"
            }
        },
        {
            "comment": "cardView declaration files link component tier names through var(--dx-card-view-…).",
            "files": [
                "scss/widgets/fluent-next/cardView/_colors.scss",
                "scss/widgets/fluent-next/cardView/_sizes.scss"
            ],
            "rules": {
                "declaration-property-value-disallowed-list": [
                    { "/.*/": ["/var\\(\\s*--dxds-/"] },
                    { "message": "Read a design token through the ds bridge (ds.$name), not as a custom property: the bridge fails the build on an unknown name, a custom property compiles and degrades silently." }
                ]
            }
        }
    ]
}
