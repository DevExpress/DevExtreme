{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "rewriteRelativeImportExtensions": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "resolveJsonModule": true,
        "lib": [
            "es2022"
        ],
        "types": [
            "node"
        ]
    },
    "include": [
        "build/**/*.ts",
        "tools/**/*.ts"
    ]
}
