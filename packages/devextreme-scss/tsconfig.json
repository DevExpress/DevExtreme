{
    "compilerOptions": {
        "noEmit": true,
        "strict": true,
        "target": "es2022",
        "module": "preserve",
        "moduleResolution": "bundler",
        "lib": [
            "es2022"
        ],
        "types": [
            "node",
            "jest"
        ],
        "forceConsistentCasingInFileNames": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": [
        "build/tokens/**/*.ts",
        "tests/**/*.ts"
    ]
}
