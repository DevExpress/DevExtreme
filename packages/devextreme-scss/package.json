{
  "name": "devextreme-scss",
  "type": "module",
  "author": "Developer Express Inc.",
  "license": "SEE LICENSE IN LICENSE.md",
  "devDependencies": {
    "@devexpress/design-tokens-internal": "262.26.0",
    "@eslint/eslintrc": "catalog:",
    "@stylistic/eslint-plugin": "catalog:",
    "@stylistic/stylelint-plugin": "3.1.3",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "autoprefixer": "10.5.0",
    "clean-css": "5.3.3",
    "eslint": "catalog:",
    "eslint-config-devextreme": "catalog:",
    "eslint-migration-utils": "workspace:*",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-jest": "29.15.2",
    "globals": "catalog:",
    "opentype.js": "1.3.4",
    "postcss": "^8.5.23",
    "safe-ts-transforms-fork": "0.0.1",
    "sass-embedded": "1.93.3",
    "style-dictionary": "5.4.4",
    "stylelint": "catalog:",
    "stylelint-config-standard-scss": "14.0.0",
    "stylelint-scss": "6.10.0",
    "ts-jest": "29.4.12",
    "typescript": "catalog:tools"
  },
  "scripts": {
    "build": "pnpm --workspace-root nx build devextreme-scss",
    "check-naming-registries": "pnpm run naming:check",
    "lint": "pnpm run lint-css && pnpm run lint-js",
    "lint-css": "stylelint scss/widgets build",
    "lint-js": "eslint",
    "naming:baseline": "UPDATE_NAMING_BASELINE=1 jest --no-coverage --runInBand --config=./tests/jest.config.json",
    "naming:check": "node tools/naming/rename.mjs --check && node tools/naming/rename.mjs --residue && node tools/naming/derive-registries.mjs --check && node tools/naming/publish.mjs --check && node tools/review/reachability.mjs",
    "naming:propose": "node tools/naming/propose.mjs",
    "naming:publish": "node tools/naming/publish.mjs",
    "naming:registries": "node tools/naming/derive-registries.mjs",
    "naming:residue": "node tools/naming/rename.mjs --residue",
    "review:evidence": "node tools/review/evidence.mjs",
    "test": "jest --no-coverage --runInBand --config=./tests/jest.config.json",
    "tokens:update": "node tools/tokens/update.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "watch": "pnpm --workspace-root nx run devextreme-scss --target=watch"
  },
  "version": "26.2.0"
}
