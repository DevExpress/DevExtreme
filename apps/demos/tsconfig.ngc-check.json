{
  "compilerOptions": {
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "ignoreDeprecations": "6.0",
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "fullTemplateTypeCheck": true
  },

  "include": [
    "Demos/Scheduler/**/Angular/**/*.ts",
    "Demos/Localization/**/Angular/**/*.ts",
    "Demos/Map/**/Angular/**/*.ts",
    "Demos/VectorMap/**/Angular/**/*.ts",
    "Demos/TileView/**/Angular/**/*.ts",
    "Demos/Splitter/**/Angular/**/*.ts",
    "Demos/Gallery/**/Angular/**/*.ts",
    "Demos/ScrollView/**/Angular/**/*.ts",
    "Demos/Box/**/Angular/**/*.ts",
    "Demos/ResponsiveBox/**/Angular/**/*.ts",
    "shared/anti-forgery/index.d.ts"
  ]
}
