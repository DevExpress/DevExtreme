{
  "compilerOptions": {
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "ignoreDeprecations": "6.0",
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "fullTemplateTypeCheck": true
  },

  "include": [
    "Demos/Autocomplete/**/Angular/**/*.ts",
    "Demos/Calendar/**/Angular/**/*.ts",
    "Demos/Chat/**/Angular/**/*.ts",
    "Demos/CheckBox/**/Angular/**/*.ts",
    "Demos/ColorBox/**/Angular/**/*.ts",
    "Demos/Common/**/Angular/**/*.ts",
    "Demos/DateBox/**/Angular/**/*.ts",
    "Demos/DateRangeBox/**/Angular/**/*.ts",
    "Demos/DropDownBox/**/Angular/**/*.ts",
    "Demos/DropDownButton/**/Angular/**/*.ts",
    "Demos/FileUploader/**/Angular/**/*.ts",
    "Demos/HtmlEditor/**/Angular/**/*.ts",
    "Demos/LoadIndicator/**/Angular/**/*.ts",
    "Demos/LoadPanel/**/Angular/**/*.ts",
    "Demos/Lookup/**/Angular/**/*.ts",
    "Demos/NumberBox/**/Angular/**/*.ts",
    "Demos/ProgressBar/**/Angular/**/*.ts",
    "Demos/Popover/**/Angular/**/*.ts",
    "Demos/Popup/**/Angular/**/*.ts",
    "Demos/ProgressBar/**/Angular/**/*.ts",
    "Demos/RangeSlider/**/Angular/**/*.ts",
    "Demos/Resizable/**/Angular/**/*.ts",
    "Demos/Scheduler/**/Angular/**/*.ts",
    "Demos/Sortable/**/Angular/**/*.ts",
    "Demos/Switch/**/Angular/**/*.ts",
    "Demos/TagBox/**/Angular/**/*.ts",
    "Demos/TextArea/**/Angular/**/*.ts",
    "Demos/TextBox/**/Angular/**/*.ts",
    "Demos/Toast/**/Angular/**/*.ts",
    "Demos/Tooltip/**/Angular/**/*.ts",
    "Demos/Validation/**/Angular/**/*.ts",
    "Demos/Scheduler/**/Angular/**/*.ts",
    "Demos/Localization/**/Angular/**/*.ts",
    "Demos/Map/**/Angular/**/*.ts",
