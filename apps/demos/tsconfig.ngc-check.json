{
  "compilerOptions": {
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "fullTemplateTypeCheck": true
  },

  "include": [
    "Demos/**/Angular/**/*.ts",
    "shared/anti-forgery/index.d.ts"
  ],
  // Sections whose Angular demos are not yet fixed for strict mode. Remove a section when its demos are fixed.
  "exclude": [
    "Demos/Accordion/**",
    "Demos/ActionSheet/**",
    "Demos/Autocomplete/**",
    "Demos/Box/**",
    "Demos/Button/**",
    "Demos/ButtonGroup/**",
    "Demos/Calendar/**",
    "Demos/CardView/**",
    "Demos/Charts/**",
    "Demos/Chat/**",
    "Demos/CheckBox/**",
    "Demos/ColorBox/**",
    "Demos/Common/**",
    "Demos/ContextMenu/**",
    "Demos/DataGrid/**",
    "Demos/DateBox/**",
    "Demos/DateRangeBox/**",
    "Demos/Diagram/**",
    "Demos/Drawer/**",
    "Demos/DropDownBox/**",
    "Demos/DropDownButton/**",
    "Demos/FieldSet/**",
    "Demos/FileManager/**",
    "Demos/FileUploader/**",
    "Demos/FilterBuilder/**",
    "Demos/FloatingActionButton/**",
    "Demos/Form/**",
    "Demos/Gallery/**",
    "Demos/Gantt/**",
    "Demos/Gauges/**",
    "Demos/HtmlEditor/**",
    "Demos/List/**",
    "Demos/LoadIndicator/**",
    "Demos/LoadPanel/**",
    "Demos/Lookup/**",
    "Demos/Menu/**",
    "Demos/MultiView/**",
    "Demos/NumberBox/**",
    "Demos/Pagination/**",
    "Demos/PivotGrid/**",
    "Demos/Popover/**",
    "Demos/Popup/**",
    "Demos/ProgressBar/**",
    "Demos/RadioGroup/**",
    "Demos/RangeSelector/**",
    "Demos/RangeSlider/**",
    "Demos/Resizable/**",
    "Demos/ResponsiveBox/**",
    "Demos/Scheduler/**",
    "Demos/ScrollView/**",
    "Demos/SelectBox/**",
    "Demos/Slider/**",
    "Demos/Sortable/**",
    "Demos/SpeechToText/**",
    "Demos/Splitter/**",
    "Demos/Stepper/**",
    "Demos/Switch/**",
    "Demos/TabPanel/**",
    "Demos/Tabs/**",
    "Demos/TagBox/**",
    "Demos/TextArea/**",
    "Demos/TextBox/**",
    "Demos/TileView/**",
    "Demos/Toast/**",
    "Demos/Toolbar/**",
    "Demos/Tooltip/**",
    "Demos/TreeList/**",
    "Demos/TreeView/**",
    "Demos/Validation/**"
  ]
}
